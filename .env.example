# SMTP credentials for the contact + newsletter mail handlers (server-only).
# MAHIDHA uses Roundcube on mail.mahidha.com — port 465 (implicit SSL) is verified working.
# (Switch to 587 for STARTTLS only if 465 is ever blocked.)
SMTP_HOST=mail.mahidha.com
SMTP_PORT=465
SMTP_USER=info@mahidha.com
SMTP_PASS=

# Where form submissions are delivered, and the sender identity.
# Keep SMTP_FROM on the same mailbox as SMTP_USER or the mail server may reject it.
CONTACT_TO=info@mahidha.com
SMTP_FROM="MAHIDHA <info@mahidha.com>"

# Public site URL — used for canonical URLs, sitemap, OG and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.mahidha.com
