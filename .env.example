# SMTP credentials for the contact + newsletter mail handlers (server-only).
# Use 465 for implicit TLS (secure) or 587 for STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Where form submissions are delivered, and the verified sender identity.
CONTACT_TO=hello@mahidha.com
SMTP_FROM="MAHIDHA <hello@mahidha.com>"

# Public site URL — used for canonical URLs, sitemap, OG and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.mahidha.com
